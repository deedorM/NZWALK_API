# NZWalks API Test Configuration

# API Configuration
# Set this to your local API URL or remote API endpoint
# Default: https://localhost:7070
API_BASE_URL=https://localhost:7070

# Timeout Configuration
# Set the timeout in seconds for API calls
# Default: 30 seconds
API_TIMEOUT_SECONDS=30

# Environment
# Options: Development, Staging, Production
ENVIRONMENT=Development
